generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Text
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(320)
  passwordHash String?    @map("password_hash") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions     Session[]
  analyses     Analysis[]
  oauthAccounts OAuthAccount[]
  onboarding   OnboardingProfile?

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Text
  provider          String   @db.VarChar(40)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  userId            String   @map("user_id") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model EmailVerification {
  email        String   @id @db.VarChar(320)
  name         String   @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.Text
  codeHash     String   @map("code_hash") @db.Text
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now()) @map("last_sent_at") @db.Timestamptz(6)

  @@map("email_verifications")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Text
  userId    String   @map("user_id") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model Analysis {
  id        String   @id @default(uuid()) @db.Text
  userId    String   @map("user_id") @db.Text
  decision  String   @db.VarChar(500)
  report    Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "analyses_user_created_idx")
  @@map("analyses")
}

model OnboardingProfile {
  userId      String    @id @map("user_id") @db.Text
  step1       Json?     @db.JsonB
  step2       Json?     @db.JsonB
  step3       Json?     @db.JsonB
  step4       Json?     @db.JsonB
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}
