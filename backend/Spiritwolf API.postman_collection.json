{
  "info": {
    "_postman_id": "5620fdf8-2460-4b1f-ad56-19fa0f465540",
    "name": "Spiritwolf API",
    "description": "Backend API requests. Register and verify the emailed code before password login. After login, complete all four Onboarding requests and Complete onboarding before using Create analysis. Password login does not create accounts. Use the saved Bearer token or session cookie for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "testEmail",
      "value": "taylor@example.com"
    },
    {
      "key": "testPassword",
      "value": "ChangeMe123!"
    },
    {
      "key": "testName",
      "value": "Taylor Example"
    },
    {
      "key": "verificationCode",
      "value": "000000"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "No body. Expected: 200 {\"status\":\"ok\"}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Starts registration and emails a 6-digit code; it does not create an account/session yet. Expected: 202 with a message and email. Configure SMTP on the backend, and change testEmail if already registered."
          },
          "response": []
        },
        {
          "name": "Verify email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const payload = pm.response.json();",
                  "  if (payload.token) pm.collectionVariables.set('authToken', payload.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{verificationCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/verify-email",
            "description": "Read the code from the email, update verificationCode, and send within 5 minutes. Successful response is 201 with user and token; the collection saves the token for subsequent calls."
          },
          "response": []
        },
        {
          "name": "Resend verification code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/verification/resend",
            "description": "Resends a code for a pending registration. Wait at least one minute between requests."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const payload = pm.response.json();",
                  "  if (payload.token) pm.collectionVariables.set('authToken', payload.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Only works after Register and Verify email have successfully created the account. Login never creates an account. Expected: 200 with a user, token, and session cookie; the collection saves the token. Unregistered or unverified users receive 401."
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Requires the Bearer token saved after email verification or login. Expected: 200 {\"user\":{\"id\":\"...\",\"name\":\"...\",\"email\":\"...\"}}."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.unset('authToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "No body. Clears the session cookie. Expected: 200 {\"message\":\"Logged out.\"}."
          },
          "response": []
        },
        {
          "name": "Google OAuth start",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/google",
            "description": "Browser-based OAuth flow; configure Google credentials and start this endpoint in a browser. It redirects to Google. The Google callback is handled at /api/auth/google/callback."
          },
          "response": []
        },
        {
          "name": "Google OAuth callback (manual/browser flow only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/google/callback?code={{googleCode}}&state={{googleState}}",
            "description": "Google supplies these query parameters and the matching state cookie during the browser sign-in flow. Do not send placeholder values; this request is listed for endpoint reference only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Onboarding",
      "description": "Requires a session. Save all four steps, then call Complete onboarding before Create analysis. Saved steps can be fetched to resume the form.",
      "item": [
        {
          "name": "Get onboarding status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/onboarding",
            "description": "Requires a session. Returns saved steps, completion status, and nextStep (1-4 or null). Expected: 200 {\"onboarding\":{\"steps\":{\"1\":null,\"2\":null,\"3\":null,\"4\":null},\"completed\":false,\"completedAt\":null,\"nextStep\":1}}."
          },
          "response": []
        },
        {
          "name": "Save step 1 - Business",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Spiritwolf Labs\",\n  \"industry\": \"B2B Cloud Infrastructure & SaaS\",\n  \"stage\": \"Growing\",\n  \"description\": \"We build telemetry pipelines and workflow automation for software teams.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/onboarding/steps/1",
            "description": "Saves business name, industry, company stage, and optional short description. Stage: Idea, Early, Growing, or Established."
          },
          "response": []
        },
        {
          "name": "Save step 2 - Ideal customer profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetCustomerProfile\": \"Mid-market CISOs & Security Directors\",\n  \"customerTypes\": [\"B2B Mid-Market\"],\n  \"geographicMarkets\": [\"North America\"],\n  \"averageDealSize\": \"$45,000\",\n  \"salesMotion\": \"Sales-Assisted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/onboarding/steps/2",
            "description": "Customer types: B2B Enterprise, B2B Mid-Market, B2C / Consumer, B2B2C. Geographic markets: North America, Europe / UK, APAC, Global. Sales motion (optional): Product-Led (PLG), Sales-Assisted, Channel / Partner."
          },
          "response": []
        },
        {
          "name": "Save step 3 - Competitors and pricing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"competitors\": [\"Vanta\", \"Drata\"],\n  \"pricingModel\": \"Subscription / SaaS\",\n  \"competitiveMoats\": [\"Proprietary IP\", \"Switching Cost\"],\n  \"pricingFriction\": \"Enterprise prospects request customized security riders before signing.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/onboarding/steps/3",
            "description": "Competitors may be an empty array. Pricing model: Subscription / SaaS, Usage-based, Per-Seat, Fixed Tier. Competitive moat (optional): Proprietary IP, Switching Cost, Data Network Effects, Speed to Deployment. Pricing friction is optional and limited to 250 characters."
          },
          "response": []
        },
        {
          "name": "Save step 4 - Goals and challenges",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quarterlyGoals\": [\"Increase Conversion / Win Rate\", \"Reduce Churn\"],\n  \"biggestObstacle\": \"Unclear ICP Definition\",\n  \"businessInquiry\": \"Where should we focus next: enterprise outbound or product-led growth?\",\n  \"planningHorizon\": \"12+ Months\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/onboarding/steps/4",
            "description": "Choose one or more quarterly goals. Biggest obstacle: Unclear ICP Definition, Resource Constraints, Long Sales Cycles, or Product Differentiation. Planning horizon: 1-3 Months, 6 Months, or 12+ Months."
          },
          "response": []
        },
        {
          "name": "Complete onboarding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/onboarding/complete",
            "description": "Call after all four steps have been saved. Expected: 200 with onboarding.completed=true and next=\"analysis\". Missing steps return 409."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "Create analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"Should we launch the new subscription plan?\",\n  \"details\": \"We are considering a three-month pilot before a full launch.\",\n  \"context\": \"Current retention is 84%; the plan is still being validated.\",\n  \"externalResearch\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/analysis",
            "description": "Requires a session, completed onboarding, and a configured backend AI_API_KEY. The saved onboarding profile is automatically included in the analysis context. If onboarding is incomplete, returns 409. Expected: 201 {\"analysis\":{\"id\":\"...\",\"decision\":\"...\",\"report\":{\"executiveSummary\":\"...\",\"recommendation\":\"...\",\"confidence\":\"low|medium|high\",\"keyConsiderations\":[\"...\"],\"nextSteps\":[\"...\"],\"assumptions\":[\"...\"],\"risks\":[\"...\"]},\"createdAt\":\"...\"}}."
          },
          "response": []
        },
        {
          "name": "Analysis history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/analysis/history",
            "description": "Requires a session. No body. Expected: 200 {\"analyses\":[...]} with up to 50 latest reports."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Read uploaded file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/files/read",
            "description": "Requires a session. Select a local .txt, .csv, .md, .pdf, or .xlsx file for the file form field. Do not set Content-Type manually; Postman adds the multipart boundary. Expected: 200 {\"fileName\":\"notes.txt\",\"text\":\"...\",\"characters\":123}."
          },
          "response": []
        }
      ]
    }
  ]
}
